{
  "name": "auth-conformance-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/conformance build && bun run --cwd examples/hono-user-admin build",
    "format:check": "biome check .",
    "test": "bun run build && bun test packages examples",
    "test:package": "bun scripts/test-package.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
