{
  "name": "auth-conformance",
  "version": "0.1.1",
  "description": "Authorization contract testing for any HTTP API, authored in TypeScript",
  "keywords": [
    "authorization",
    "contract-testing",
    "api-testing",
    "openapi",
    "security-testing"
  ],
  "homepage": "https://github.com/tylerchambers/auth-conformance#readme",
  "bugs": {
    "url": "https://github.com/tylerchambers/auth-conformance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerchambers/auth-conformance.git",
    "directory": "packages/conformance"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js",
      "default": "./dist/authoring.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
